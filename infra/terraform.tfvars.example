# Phase 5: Entra External ID tenant (created manually, see docs/guides/fase-5-identidad.md)
external_tenant_id        = "00000000-0000-0000-0000-000000000000"
external_tenant_subdomain = "yourtenant" # <subdomain>.ciamlogin.com

