<mxCell id="e23" value="7. modelo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b9" target="i12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1080" y="260"/><mxPoint x="1080" y="138"/></Array></mxGeometry></mxCell>
